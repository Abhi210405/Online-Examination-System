# Development can generate a private key in instance/ when this is unset.
# Set SECRET_KEY locally if you need stable sessions across app restarts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
APP_ENV=development
# SQLite is the local default; relative SQLite filenames live under instance/.
# DATABASE_URL=sqlite:///college_exam_system.sqlite3
# For Neon, use the complete connection URI from the Neon dashboard. The
# DATABASE_URL value must start with postgresql://, not the literal text
# DATABASE_URL, a placeholder, or a SQLite URL. Never put real credentials here.
# Production only: set APP_ENV=production, a private SECRET_KEY, and a
# persistent PostgreSQL URL. Do not use SQLite on Vercel.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Optional production Host allowlist (comma-separated); *.vercel.app is the
# default. Add your custom domain when using one.
# TRUSTED_HOSTS=*.vercel.app,exams.example.edu
